# Cloudflare API Token (erstellen unter: dash.cloudflare.com → My Profile → API Tokens)
# Benötigte Rechte: Cloudflare Pages Edit, Account Settings Read
CLOUDFLARE_API_TOKEN=

# Cloudflare Account ID (Dashboard → Rechts in der Sidebar unter Account ID)
CLOUDFLARE_ACCOUNT_ID=

# Optional: für GitHub Actions Deploy
# Als Repository Secret in GitHub hinterlegen – NICHT in .env committen
